# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://smbagentsai.com
# Supabase (optional — app falls back to data/use-cases.json and no-op signups without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used by scripts/seed.mjs and API routes for inserts
SUPABASE_SERVICE_ROLE_KEY=
# Content engine (GitHub Actions secrets; see README "Daily content engine")
REVALIDATE_SECRET=
OPENAI_API_KEY=
# or: ANTHROPIC_API_KEY=
# ENGINE_LLM_PROVIDER=openai|anthropic   ENGINE_LLM_MODEL=gpt-4o-mini   ENGINE_MAX_PER_RUN=15   ENGINE_AUTO_PUBLISH=true
# Email (optional, not yet configured): plug in Resend for welcome/referral emails
RESEND_API_KEY=
EMAIL_FROM="SMB Agents AI <hello@smbagentsai.com>"
